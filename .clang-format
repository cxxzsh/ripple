---
BasedOnStyle: Google
Language: Cpp
IndentWidth: 2
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^".*\.h(pp)?"'
    Priority:        1
  - Regex:           '^<.*\.h>'
    Priority:        2
  - Regex:           '^<[a-z_]+>'
    Priority:        3
  - Regex:           '^<ripple/'
    Priority:        5
  - Regex:           '.*'
    Priority:        4
